generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            String   @id @default(uuid())
  username      String   @unique
  password_hash String
  role          String   @default("admin")
  created_at    DateTime @default(now())
}

model Event {
  id            String   @id @default(uuid())
  name          String
  date          DateTime
  is_active     Boolean  @default(true)
  login_open    Boolean  @default(false)
  layouts       VenueLayout[]
  participants  Participant[]
  systemState   SystemState?
  chatMessages  ChatMessage[]
  adminLogs     AdminLog[]
  sessionColors SessionColor[]
}

model VenueLayout {
  id                String   @id @default(uuid())
  event_id          String
  event             Event    @relation(fields: [event_id], references: [id])
  rows              Int
  cols              Int
  aisle_after_rows  String?  // JSON: 복도가 있는 행 뒤 번호 예: "[2,5]"
  aisle_after_cols  String?  // JSON: 복도가 있는 열 뒤 번호 예: "[3,7]"
  layout_mode       String?  @default("simple") // "simple"(행/열 격자) | "grid"(CSV 격자 업로드)
  seats             Seat[]
}

model Seat {
  id            String   @id @default(uuid())
  layout_id     String
  layout        VenueLayout @relation(fields: [layout_id], references: [id])
  row           Int
  col           Int
  status        String   // "EMPTY", "RESERVED", "AUTO_ASSIGNED", "LOCKED", "MANUAL"
  assigned_to   String?  // Participant ID
  session_id    String?  // The session this seat was reserved in
  manual_label  String?  // 관리자 수동 배정 시 표시할 이름
  seat_label    String?  // 격자 CSV 업로드 시 좌석 고유 번호/라벨 (예: "42")
  updated_at    DateTime @updatedAt
  
  @@unique([layout_id, row, col])
}

model Participant {
  id                  String   @id @default(uuid())
  event_id            String
  event               Event    @relation(fields: [event_id], references: [id])
  session_id          String
  name                String
  phone_last4         String
  unique_code         String?
  turn_order          Int
  allowed_start_time  DateTime?
  allowed_end_time    DateTime?
  seat_id             String?  @unique
  session_token       String?
  is_final            Boolean  @default(false)
  turn_status         String   @default("WAITING") // "WAITING", "ACTIVE", "COMPLETED", "EXPIRED"
}

model SessionColor {
  id            String   @id @default(uuid())
  event_id      String
  event         Event    @relation(fields: [event_id], references: [id])
  session_id    String
  color         String
  start_time    String?
  end_time      String?
  
  @@unique([event_id, session_id])
}

model SystemState {
  id                      String   @id @default(uuid())
  event_id                String   @unique
  event                   Event    @relation(fields: [event_id], references: [id])
  is_frozen               Boolean  @default(false)
  frozen_reason           String?
  frozen_at               DateTime?
  current_turn_order      Int      @default(1)
  current_turn_start_time DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(uuid())
  event_id      String
  event         Event    @relation(fields: [event_id], references: [id])
  sender_type   String   // "ADMIN", "USER"
  sender_name   String
  content       String
  timestamp     DateTime @default(now())
}

model AdminLog {
  id            String   @id @default(uuid())
  event_id      String
  event         Event    @relation(fields: [event_id], references: [id])
  action        String
  details       String
  timestamp     DateTime @default(now())
}
